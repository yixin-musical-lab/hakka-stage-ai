# -----------------------------------------------------------------------------
# 客韵智演 / hakka-stage-ai 本地开发环境示例
# 复制为 .env 后可以按需修改。不要把真实密钥提交到仓库。
# -----------------------------------------------------------------------------

PROJECT_NAME=hakka-stage-ai

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 登录鉴权
# 本地开发可使用示例值；部署到公开环境前必须替换为足够长的随机字符串。
AUTH_SECRET_KEY=local-dev-only-change-me-at-least-32-bytes
AUTH_ACCESS_TOKEN_MINUTES=480
# 公开环境使用 HTTPS 时设为 true，本地 HTTP 联调保持 false。
AUTH_COOKIE_SECURE=false

# 全新数据库首次启动时可临时填写下面两项创建首个账号。
# 首账号创建成功后请删除 BOOTSTRAP_ACCOUNT_PASSWORD；已有账号时不会重复创建。
BOOTSTRAP_ACCOUNT_EMAIL=
BOOTSTRAP_ACCOUNT_PASSWORD=
BOOTSTRAP_ACCOUNT_DISPLAY_NAME=平台初始账号
BOOTSTRAP_ACCOUNT_ROLE=teacher

# Frontend
# auto 表示前端会按当前访问主机自动请求同一台机器的 8000 端口。
# 例如访问 http://172.26.48.1:5173 时，会请求 http://172.26.48.1:8000。
VITE_API_BASE_URL=auto

# LLM
# 真实密钥只写入本地 .env，不能提交到 Git。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_DEFAULT_PROVIDER=deepseek
LLM_DEFAULT_MODEL=deepseek-v4-flash
LLM_DEFAULT_REASONING_LEVEL=standard
LLM_MOCK_MODE=false
LLM_TIMEOUT_SECONDS=120

# GRS AI Veo 图生视频
# 真实密钥只写入本地 .env；GRSAI_PUBLIC_BASE_URL 必须是 GRS AI 能访问的后端根地址。
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsai.dakka.com.cn
GRSAI_PUBLIC_BASE_URL=
GRSAI_TIMEOUT_SECONDS=30
GRSAI_MOCK_MODE=false
GRSAI_IMAGE_MAX_UPLOAD_MB=10

# 原媒体工作台：RunningHub 克隆音频与 GRS AI 图生图
# 默认开启 Mock，可验证提交、轮询、MinIO 转存与展示且不会产生第三方费用。
MEDIA_MOCK_MODE=true
MEDIA_MAX_UPLOAD_MB=200
MEDIA_HTTP_TIMEOUT_SECONDS=120
MEDIA_POLL_INTERVAL_SECONDS=5
MEDIA_POLL_MAX_COUNT=720
GRSAI_POLL_INTERVAL_SECONDS=15
GRSAI_POLL_MAX_COUNT=400
RUNNINGHUB_API_KEY=
RUNNINGHUB_BASE_URL=https://www.runninghub.cn

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=hakka_stage_ai
POSTGRES_USER=hakka
POSTGRES_PASSWORD=hakka_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MinIO
MINIO_ENDPOINT=http://minio:9000
MINIO_BROWSER_REDIRECT_URL=http://localhost:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=hakka-stage-ai
M08_VIDEO_MAX_UPLOAD_MB=200
